# Base de datos (SQLite por defecto; cambia el provider en prisma/schema.prisma si usas Postgres)
DATABASE_URL="file:./dev.db"

# Sesiones
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL del frontend (para CORS y redirecciones de Stripe)
CLIENT_URL="http://localhost:5173"
PORT=4000

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Drive (cuenta de servicio) — para guardar las fotos de los outfits
# 1. Crea un proyecto en console.cloud.google.com, habilita "Google Drive API".
# 2. Crea una cuenta de servicio, descarga el JSON de credenciales.
# 3. Crea una carpeta en Drive y compártela con el email de la cuenta de servicio
#    (client_email dentro del JSON) con permiso de Editor.
# 4. Pega aquí el JSON completo en una sola línea, y el ID de la carpeta (está en la URL de Drive).
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
GOOGLE_DRIVE_FOLDER_ID="id-de-la-carpeta-de-drive"
