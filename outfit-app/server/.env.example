# Base de datos (SQLite por defecto; cambia el provider en prisma/schema.prisma si usas Postgres)
DATABASE_URL="file:./dev.db"

# Sesiones
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL del frontend (para CORS y redirecciones de Stripe)
CLIENT_URL="http://localhost:5173"
PORT=4000

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary — para guardar las fotos de los outfits
# Crea una cuenta gratis en cloudinary.com y copia estos tres valores
# de tu Dashboard (Product Environment Credentials).
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu-api-secret"
